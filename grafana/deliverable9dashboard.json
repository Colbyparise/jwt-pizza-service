{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Grafana Cloud Loki data source",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "loki", "name": "Loki", "version": "1.0.0" },
    { "type": "panel", "id": "logs", "name": "Logs", "version": "" }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "panels": [
    {
      "id": 1,
      "title": "All service logs",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{source=\"jwt-pizza-service\"}", "queryType": "range", "datasource": { "type": "loki", "uid": "${DS_LOKI}" } }],
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 0 },
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 2,
      "title": "HTTP requests",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{source=\"jwt-pizza-service\",type=\"http\"}", "queryType": "range", "datasource": { "type": "loki", "uid": "${DS_LOKI}" } }],
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 12 },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 3,
      "title": "Database queries",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{source=\"jwt-pizza-service\",type=\"database\"}", "queryType": "range", "datasource": { "type": "loki", "uid": "${DS_LOKI}" } }],
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 12 },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 4,
      "title": "Factory requests",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{source=\"jwt-pizza-service\",type=\"factory\"}", "queryType": "range", "datasource": { "type": "loki", "uid": "${DS_LOKI}" } }],
      "gridPos": { "h": 10, "w": 12, "x": 0, "y": 22 },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
    },
    {
      "id": 5,
      "title": "Exceptions",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [{ "refId": "A", "expr": "{source=\"jwt-pizza-service\",type=\"exception\"}", "queryType": "range", "datasource": { "type": "loki", "uid": "${DS_LOKI}" } }],
      "gridPos": { "h": 10, "w": 12, "x": 12, "y": 22 },
      "options": { "showTime": true, "showLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true }
    }
  ],
  "schemaVersion": 40,
  "tags": ["jwt-pizza", "logging"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Pizza Dashboard - Logging",
  "uid": null,
  "version": 1
}
